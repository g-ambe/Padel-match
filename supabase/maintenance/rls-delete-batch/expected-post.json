      "with_check": "((auth.uid() IS NOT NULL) AND (EXISTS ( SELECT 1\n   FROM events e\n  WHERE ((e.id = event_participants.event_id) AND (NOT COALESCE(e.is_deleted, false)) AND (is_super_user() OR ((e.club_id IS NULL) AND (e.created_by_auth_user_id = auth.uid())) OR (EXISTS ( SELECT 1\n           FROM (club_members cm\n             LEFT JOIN player_profiles pp ON ((pp.id = cm.player_profile_id)))\n          WHERE ((cm.club_id = e.club_id) AND cm.is_active AND ((cm.profile_id = auth.uid()) OR (pp.linked_auth_user_id = auth.uid()))))) OR ((e.event_mode = 'team'::text) AND can_manage_friendly_team_event_by_sides(e.id, e.created_by_auth_user_id)))))) AND (((participant_type = 'guest'::text) AND (profile_id IS NULL) AND (player_profile_id IS NULL)) OR ((participant_type = 'member'::text) AND (is_super_user() OR (EXISTS ( SELECT 1\n   FROM events e\n  WHERE ((e.id = event_participants.event_id) AND (((e.club_id IS NULL) AND (((event_participants.player_profile_id IS NULL) AND (event_participants.profile_id = auth.uid())) OR (EXISTS ( SELECT 1\n           FROM player_profiles self\n          WHERE ((self.id = event_participants.player_profile_id) AND self.is_active AND (self.linked_auth_user_id = auth.uid())))))) OR (EXISTS ( SELECT 1\n           FROM club_members target\n          WHERE ((target.club_id = e.club_id) AND target.is_active AND (((event_participants.player_profile_id IS NOT NULL) AND (target.player_profile_id = event_participants.player_profile_id)) OR ((target.player_profile_id IS NULL) AND (target.profile_id = event_participants.player_profile_id)) OR ((event_participants.player_profile_id IS NULL) AND (target.profile_id = event_participants.profile_id))))))))))))))"
    },
