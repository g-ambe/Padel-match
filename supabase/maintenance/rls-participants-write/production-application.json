      "definition": "CREATE OR REPLACE FUNCTION events_identity_private.guard_event_identity()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO ''\nAS $function$\nBEGIN\n IF current_user IN ('anon','authenticated')\n AND (NEW.id IS DISTINCT FROM OLD.id\n   OR NEW.club_id IS DISTINCT FROM OLD.club_id\n   OR NEW.created_by_auth_user_id IS DISTINCT FROM OLD.created_by_auth_user_id)\n THEN\n   RAISE EXCEPTION '開催のID・所属グループ・作成者は変更できません' USING ERRCODE='42501';\n END IF;\n RETURN NEW;\nEND\n$function$\n",
